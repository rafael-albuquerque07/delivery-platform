{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deliveryplatform.dev/contracts/events/_envelope-v1.json",
  "title": "Envelope comum de evento de negócio",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "examples": ["PedidoRecebido", "LiquidacaoConfirmada"] },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
