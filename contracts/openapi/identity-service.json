{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "identity-service",
    "description" : "Conta de acesso ao painel: cadastro com verificação por telefone, login e a chave pública com que os demais serviços validam o token.",
    "version" : "v1"
  },
  "paths" : {
    "/api/v1/auth/verification-code" : {
      "post" : {
        "tags" : [ "cadastro-controller" ],
        "operationId" : "solicitarCodigo",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerificationCodeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        }
      }
    },
    "/api/v1/auth/signup" : {
      "post" : {
        "tags" : [ "cadastro-controller" ],
        "operationId" : "cadastrar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SignupResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "autenticacao-controller" ],
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json" : {
      "get" : {
        "tags" : [ "jwks-controller" ],
        "operationId" : "jwks",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : { }
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "VerificationCodeRequest" : {
        "type" : "object",
        "properties" : {
          "telefone" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "telefone" ]
      },
      "SignupRequest" : {
        "type" : "object",
        "properties" : {
          "telefone" : {
            "type" : "string",
            "minLength" : 1
          },
          "codigo" : {
            "type" : "string",
            "minLength" : 1
          },
          "nome" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "senha" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 8
          }
        },
        "required" : [ "codigo", "nome", "senha", "telefone" ]
      },
      "SignupResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "id" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "telefone" : {
            "type" : "string",
            "minLength" : 1
          },
          "senha" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "senha", "telefone" ]
      },
      "LoginResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "tokenType" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "accessToken", "expiresIn", "tokenType" ]
      }
    }
  }
}
