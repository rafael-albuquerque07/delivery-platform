{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "merchant-service",
    "description" : "Estabelecimento, equipe e áreas de entrega. Toda rota exige token emitido pelo identity-service, e a autorização é resolvida pelo vínculo do usuário com a loja da URL.",
    "version" : "v1"
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "eu",
    "description" : "O que o portador do token é, neste serviço."
  }, {
    "name" : "interno",
    "description" : "Consumido por outro serviço, com o token de quem pediu encaminhado. Não roteado pelo gateway — ADR-045."
  } ],
  "paths" : {
    "/api/v1/merchants/{estabelecimentoId}/settings/pedido-minimo" : {
      "get" : {
        "tags" : [ "configuracao-da-loja-controller" ],
        "summary" : "Lê os pedidos mínimos da loja, por modalidade",
        "description" : "Exige CONFIGURAR_LOJA. Zero é \"sem mínimo\".",
        "operationId" : "lerPedidoMinimo",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Os mínimos gravados, zero inclusive",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PedidoMinimoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Identificador da loja malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem CONFIGURAR_LOJA ou loja inexistente — a mesma recusa"
          }
        }
      },
      "put" : {
        "tags" : [ "configuracao-da-loja-controller" ],
        "summary" : "Define os pedidos mínimos da loja, por modalidade",
        "description" : "Exige CONFIGURAR_LOJA. Substitui todos; uma entrada por modalidade aceita. Zero vale como \"sem mínimo\".",
        "operationId" : "definirPedidoMinimo",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PedidoMinimoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Os mínimos como ficaram gravados",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PedidoMinimoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo malformado, modalidade desconhecida, identificador da loja malformado, ou mínimos que o domínio recusa — modalidade aceita sem entrada, entrada para modalidade que a loja não aceita, ou valor negativo (M17)"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem CONFIGURAR_LOJA ou loja inexistente — a mesma recusa"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/settings/horario" : {
      "get" : {
        "tags" : [ "configuracao-da-loja-controller" ],
        "summary" : "Lê o horário semanal da loja",
        "description" : "Exige CONFIGURAR_LOJA. Mapa vazio quando a loja não abre por horário.",
        "operationId" : "lerHorario",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "O horário gravado; mapa vazio quando a loja não abre por horário",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HorarioResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Identificador da loja malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem CONFIGURAR_LOJA ou loja inexistente — a mesma recusa"
          }
        }
      },
      "put" : {
        "tags" : [ "configuracao-da-loja-controller" ],
        "summary" : "Define o horário semanal da loja",
        "description" : "Exige CONFIGURAR_LOJA. Substitui o horário inteiro; mapa vazio volta a loja a \"nunca abre por horário\".",
        "operationId" : "definirHorario",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/HorarioRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "O horário como ficou gravado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HorarioResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo malformado, dia que não é dia da semana, identificador da loja malformado, ou faixa que o domínio recusa — início igual ao fim, ou a mesma faixa duas vezes no mesmo dia"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem CONFIGURAR_LOJA ou loja inexistente — a mesma recusa"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/settings/desconto-retirada" : {
      "get" : {
        "tags" : [ "configuracao-da-loja-controller" ],
        "summary" : "Lê o desconto de retirada da loja",
        "description" : "Exige CONFIGURAR_LOJA. Zero é sem desconto.",
        "operationId" : "lerDescontoDeRetirada",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "O desconto gravado; zero quando não há",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DescontoDeRetiradaResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Identificador da loja malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem CONFIGURAR_LOJA ou loja inexistente — a mesma recusa"
          }
        }
      },
      "put" : {
        "tags" : [ "configuracao-da-loja-controller" ],
        "summary" : "Define o desconto de retirada da loja",
        "description" : "Exige CONFIGURAR_LOJA. Valor fixo, para a loja inteira; zero é sem desconto.",
        "operationId" : "definirDescontoDeRetirada",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DescontoDeRetiradaRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "O desconto como ficou gravado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DescontoDeRetiradaResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo malformado, identificador da loja malformado, ou desconto negativo (M15)"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem CONFIGURAR_LOJA ou loja inexistente — a mesma recusa"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/team/convites" : {
      "post" : {
        "tags" : [ "equipe-controller" ],
        "summary" : "Convida alguém para a equipe",
        "description" : "Exige GERENCIAR_EQUIPE, e só se oferece o que se tem (A2). O token do convite só aparece nesta resposta; o transporte é humano, pela mão de quem convida (ADR-069).",
        "operationId" : "convidar",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ConviteRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "O convite emitido, com o token — que não se lê de novo",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConviteEmitidoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo malformado, telefone inválido, ou permissão oferecida que quem convida não tem (A2)"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem GERENCIAR_EQUIPE ou loja inexistente — a mesma recusa"
          }
        }
      }
    },
    "/api/v1/me/estabelecimentos" : {
      "get" : {
        "tags" : [ "eu" ],
        "summary" : "As lojas de que o portador do token faz parte",
        "description" : "Só vínculos ATIVOS. Traz papel e permissões de cada uma, para o front montar o seletor de loja e o menu numa chamada só. Lista vazia quando não há vínculo ativo em nenhuma loja.",
        "operationId" : "minhasLojas",
        "responses" : {
          "200" : {
            "description" : "As lojas em que o portador tem vínculo ativo",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/LojaDoUsuario"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          }
        }
      },
      "post" : {
        "tags" : [ "eu" ],
        "summary" : "Cria uma loja, e o portador do token passa a ser o fundador dela",
        "description" : "O corpo traz identificação, política de troco, tipo de operação e métodos por modalidade. A loja nasce sem horário e sem área de entrega; pedido mínimo e desconto de retirada nascem em zero.",
        "operationId" : "criar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CriarEstabelecimentoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "A loja criada, e o portador é o fundador dela",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LojaDoUsuario"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo que o agregado recusa"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          }
        }
      }
    },
    "/api/v1/convites/{token}/aceite" : {
      "post" : {
        "tags" : [ "convite-controller" ],
        "summary" : "Aceita o convite",
        "description" : "Exige sessão e nenhuma permissão. A A2 é conferida de novo aqui: se quem convidou perdeu o que ofereceu, o aceite é recusado.",
        "operationId" : "aceitar",
        "parameters" : [ {
          "name" : "token",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "O vínculo que nasceu",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AceiteResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Sem sessão"
          },
          "404" : {
            "description" : "Convite inexistente, expirado, já aceito ou cancelado — a mesma resposta"
          },
          "409" : {
            "description" : "Quem convidou não pode mais conceder o que ofereceu (A2), ou quem aceita já é da equipe"
          }
        }
      }
    },
    "/internal/merchants/{estabelecimentoId}/me/contexto-de-acesso" : {
      "get" : {
        "tags" : [ "interno" ],
        "summary" : "O contexto de acesso do portador do token nesta loja",
        "description" : "Exige apenas token válido — nenhuma permissão. Responde sobre o portador e sobre mais ninguém: não existe usuarioId na entrada. Sem vínculo ativo e loja inexistente devolvem a mesma recusa.",
        "operationId" : "doPortador",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "O contexto do portador nesta loja",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ContextoDeAcesso"
                }
              }
            }
          },
          "400" : {
            "description" : "Identificador da loja malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo ativo com a loja, ou loja inexistente — a mesma recusa"
          }
        }
      }
    },
    "/internal/merchants/{estabelecimentoId}/expediente-corrente" : {
      "get" : {
        "tags" : [ "interno" ],
        "summary" : "O dia operacional a carimbar numa marcação de disponibilidade",
        "description" : "Devolve o expediente em curso quando a loja está dentro do horário, e o da próxima abertura quando ela está fechada (ADR-049). 409 quando a loja não abre por horário. Exige vínculo ativo, e nenhuma permissão específica.",
        "operationId" : "expedienteCorrente",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "O expediente de referência para carimbar",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ExpedienteCorrenteResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Identificador da loja malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo ativo com a loja, ou loja inexistente — a mesma recusa"
          },
          "409" : {
            "description" : "A loja não abre por horário (ADR-049 §5)"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/team" : {
      "get" : {
        "tags" : [ "equipe-controller" ],
        "summary" : "Lista a equipe do estabelecimento",
        "description" : "Exige vínculo ativo com GERENCIAR_EQUIPE. Sem vínculo, sem permissão e loja inexistente devolvem a mesma recusa.",
        "operationId" : "listar",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "A equipe da loja",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EquipeResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Identificador da loja malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem GERENCIAR_EQUIPE ou loja inexistente — a mesma recusa"
          }
        }
      }
    },
    "/api/v1/convites/{token}" : {
      "get" : {
        "tags" : [ "convite-controller" ],
        "summary" : "O convite, para quem recebeu o link",
        "description" : "Público: quem recebe um convite ainda não tem sessão. Devolve só o nome da loja, o papel e a validade.",
        "operationId" : "ver",
        "parameters" : [ {
          "name" : "token",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "A loja, o papel e a validade do convite",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConvitePublicoResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Convite inexistente, expirado, já aceito ou cancelado — a mesma resposta"
          }
        },
        "security" : [ ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "PedidoMinimoRequest" : {
        "type" : "object",
        "properties" : {
          "pedidoMinimoPorModalidade" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "number"
            },
            "description" : "Por modalidade, o mínimo sobre o valor dos itens, sem a taxa de entrega, em reais. Uma entrada para cada modalidade que a loja aceita, e para nenhuma outra. Zero vale como \"sem mínimo\"."
          }
        },
        "required" : [ "pedidoMinimoPorModalidade" ]
      },
      "PedidoMinimoResponse" : {
        "type" : "object",
        "properties" : {
          "pedidoMinimoPorModalidade" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "number"
            }
          }
        }
      },
      "FaixaDeHorarioRequest" : {
        "type" : "object",
        "properties" : {
          "inicio" : {
            "type" : "string",
            "description" : "Hora de abrir, no fuso da loja.",
            "example" : "18:00"
          },
          "fim" : {
            "type" : "string",
            "description" : "Hora de fechar. Antes do início, a faixa cruza a meia-noite.",
            "example" : "02:00"
          }
        },
        "required" : [ "fim", "inicio" ]
      },
      "HorarioRequest" : {
        "type" : "object",
        "properties" : {
          "horarioDeFuncionamento" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "$ref" : "#/components/schemas/FaixaDeHorarioRequest"
              }
            },
            "description" : "Por dia da semana, as faixas daquele dia. Mapa vazio volta a loja ao estado sem horário — \"nunca abre por horário\". Faixas que se sobrepõem são aceitas; fim antes do início é a faixa que cruza a meia-noite."
          }
        },
        "required" : [ "horarioDeFuncionamento" ]
      },
      "FaixaDeHorarioResponse" : {
        "type" : "object",
        "properties" : {
          "inicio" : {
            "type" : "string"
          },
          "fim" : {
            "type" : "string"
          }
        }
      },
      "HorarioResponse" : {
        "type" : "object",
        "properties" : {
          "horarioDeFuncionamento" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "$ref" : "#/components/schemas/FaixaDeHorarioResponse"
              }
            }
          }
        }
      },
      "DescontoDeRetiradaRequest" : {
        "type" : "object",
        "properties" : {
          "descontoDeRetirada" : {
            "type" : "number",
            "description" : "Em reais, abatido do pedido de quem retira no balcão. Zero é sem desconto; negativo é recusado.",
            "example" : 5.0
          }
        },
        "required" : [ "descontoDeRetirada" ]
      },
      "DescontoDeRetiradaResponse" : {
        "type" : "object",
        "properties" : {
          "descontoDeRetirada" : {
            "type" : "number"
          }
        }
      },
      "ConviteRequest" : {
        "type" : "object",
        "description" : "O convite: o telefone de quem vai entrar e as permissões oferecidas.",
        "properties" : {
          "telefone" : {
            "type" : "string",
            "description" : "O telefone da pessoa convidada — o endereço, não a credencial.",
            "example" : "(81) 98765-4321",
            "minLength" : 1
          },
          "permissoes" : {
            "type" : "array",
            "description" : "As permissões oferecidas. Só as que quem convida tem (A2).",
            "items" : {
              "type" : "string",
              "enum" : [ "VER_PRODUTO", "CRIAR_PRODUTO", "ALTERAR_PRODUTO", "DESATIVAR_PRODUTO", "VER_PEDIDO", "ALTERAR_STATUS", "VER_VENDAS", "VER_ENTREGA", "GERENCIAR_EQUIPE", "GERENCIAR_JORNADA", "CONFIGURAR_LOJA" ]
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "permissoes", "telefone" ]
      },
      "ConviteEmitidoResponse" : {
        "type" : "object",
        "description" : "O convite emitido. O token só aparece nesta resposta.",
        "properties" : {
          "token" : {
            "type" : "string",
            "description" : "A credencial do convite. Mostre para copiar; não há como reler."
          },
          "expiraEm" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Até quando o convite vale."
          },
          "permissoes" : {
            "type" : "array",
            "items" : {
