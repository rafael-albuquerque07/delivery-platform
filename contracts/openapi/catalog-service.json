{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "catalog-service",
    "description" : "Produto, opções e disponibilidade qualitativa. Toda rota exige token emitido pelo identity-service, e a autorização é resolvida no merchant-service com o token de quem pediu, encaminhado (ADR-045).",
    "version" : "v1"
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/api/v1/merchants/{estabelecimentoId}/catalog/produtos/{produtoId}/publicacao" : {
      "put" : {
        "tags" : [ "produto-controller" ],
        "summary" : "Publica o produto no cardápio",
        "description" : "Exige ALTERAR_PRODUTO. Idempotente: publicar o que já está publicado responde 200. As invariantes C1, C5, C4 e C2 são cobradas aqui.",
        "operationId" : "publicar",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "produtoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "O produto, publicado — também quando já estava",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProdutoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "A publicação recusada (C1, C5, C4, C2), com a frase que diz o que corrigir; ou identificador malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem ALTERAR_PRODUTO, loja inexistente ou merchant indisponível — a mesma recusa"
          },
          "404" : {
            "description" : "O produto não existe nesta loja — inexistente ou de outra loja, a mesma resposta (ADR-056)"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/catalog/produtos/{produtoId}/grupos/{grupoId}/opcoes/{opcaoId}/disponibilidade" : {
      "put" : {
        "tags" : [ "produto-controller" ],
        "summary" : "Marca a disponibilidade de uma opção do produto",
        "description" : "Mesmo carimbo e mesmas recusas da marcação do produto. Devolve o produto recalculado, porque marcar uma opção pode derrubar o vendavel.",
        "operationId" : "marcarOpcao",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "produtoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "grupoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "opcaoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MarcacaoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "O produto recalculado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProdutoResumoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo ou identificador malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem ALTERAR_PRODUTO, loja inexistente ou merchant indisponível — a mesma recusa"
          },
          "404" : {
            "description" : "O produto não existe nesta loja (ADR-056), ou o grupo e a opção não existem neste produto (ADR-063 §4)"
          },
          "409" : {
            "description" : "ESGOTADO_HOJE numa loja que não abre por horário (ADR-049), ou o produto mudou durante a marcação (ADR-052)"
          },
          "503" : {
            "description" : "O merchant não respondeu sobre o expediente"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/catalog/produtos/{produtoId}/disponibilidade" : {
      "put" : {
        "tags" : [ "produto-controller" ],
        "summary" : "Marca a disponibilidade do produto",
        "description" : "O carimbo é do servidor: o instante pelo relógio do serviço e o expediente perguntado ao merchant (ADR-049). Exige ALTERAR_PRODUTO. 409 quando a loja não abre por horário e o estado é ESGOTADO_HOJE. Devolve o produto recalculado.",
        "operationId" : "marcarProduto",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "produtoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MarcacaoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "O produto recalculado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProdutoResumoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo inválido, ou estado que o modo do produto não tem (SEM_CONTROLE não acaba)"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem ALTERAR_PRODUTO, loja inexistente ou merchant indisponível — a mesma recusa"
          },
          "404" : {
            "description" : "O produto não existe nesta loja — inexistente ou de outra loja, a mesma resposta (ADR-056)"
          },
          "409" : {
            "description" : "ESGOTADO_HOJE numa loja que não abre por horário (ADR-049), ou o produto mudou durante a marcação (ADR-052)"
          },
          "503" : {
            "description" : "O merchant não respondeu sobre o expediente"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/catalog/produtos" : {
      "get" : {
        "tags" : [ "produto-controller" ],
        "summary" : "Lista os produtos do estabelecimento, em qualquer estado de publicação",
        "description" : "A listagem do painel: rascunho, ativo e inativo, cada um com o estadoDePublicacao. Sem sort, pela ordem e depois pelo id. Exige vínculo ativo com VER_PRODUTO, resolvido no merchant-service com o token de quem pediu. Sem vínculo, sem permissão, loja inexistente e merchant indisponível devolvem a mesma recusa.",
        "operationId" : "listar",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "description" : "Zero-based page index (0..N)",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "description" : "The size of the page to be returned",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "default" : 20,
            "minimum" : 1
          }
        }, {
          "name" : "sort",
          "in" : "query",
          "description" : "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "A página de produtos da loja, em qualquer estado de publicação",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaginaResponseProdutoResumoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Identificador ou paginação malformados"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem VER_PRODUTO, loja inexistente ou merchant indisponível — a mesma recusa"
          }
        }
      },
      "post" : {
        "tags" : [ "produto-controller" ],
        "summary" : "Cria um produto, em rascunho",
        "description" : "Exige CRIAR_PRODUTO. A seção tem de ser desta loja: inexistente e de outra loja recebem a mesma recusa. Location aponta para o GET do produto.",
        "operationId" : "criar",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ProdutoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "O produto criado, em rascunho",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProdutoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo malformado, preço negativo (C1), ou seção que não existe nesta loja (ADR-066)"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem CRIAR_PRODUTO, loja inexistente ou merchant indisponível — a mesma recusa"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/catalog/produtos/{produtoId}/grupos" : {
      "post" : {
        "tags" : [ "produto-controller" ],
        "summary" : "Cria um grupo de opções no produto",
        "description" : "Exige ALTERAR_PRODUTO. O grupo nasce vazio. Com o produto já publicado, as invariantes da publicação são recobradas, e um grupo vazio é recusado (C4). Devolve o produto inteiro.",
        "operationId" : "criarGrupo",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "produtoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GrupoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "O produto, com o grupo novo",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProdutoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo malformado, limites do grupo (C3), ou, com o produto publicado, a recusa da publicação recobrada (C4); ou identificador malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem ALTERAR_PRODUTO, loja inexistente ou merchant indisponível — a mesma recusa"
          },
          "404" : {
            "description" : "O produto não existe nesta loja — inexistente ou de outra loja, a mesma resposta (ADR-056)"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/catalog/produtos/{produtoId}/grupos/{grupoId}/opcoes" : {
      "post" : {
        "tags" : [ "produto-controller" ],
        "summary" : "Acrescenta uma opção a um grupo do produto",
        "description" : "Exige ALTERAR_PRODUTO. A opção nasce disponível, e o acréscimo aceita zero e negativo. Com o produto já publicado, as invariantes da publicação são recobradas. Devolve o produto inteiro.",
        "operationId" : "criarOpcao",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "produtoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "grupoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OpcaoRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "O produto, com a opção nova",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProdutoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Corpo malformado, ou, com o produto publicado, a recusa da publicação recobrada (C2); ou identificador malformado"
          },
          "401" : {
            "description" : "Sem token, ou token inválido"
          },
          "403" : {
            "description" : "Sem vínculo, sem ALTERAR_PRODUTO, loja inexistente ou merchant indisponível — a mesma recusa"
          },
          "404" : {
            "description" : "O produto não existe nesta loja (ADR-056), ou o grupo não existe neste produto"
          }
        }
      }
    },
    "/api/v1/merchants/{estabelecimentoId}/catalog/categorias" : {
      "get" : {
        "tags" : [ "categoria-controller" ],
        "summary" : "Lista as seções do cardápio",
        "description" : "Exige VER_PRODUTO. Ativas e inativas, pela ordem e, no empate, pelo nome.",
        "operationId" : "listar_1",
        "parameters" : [ {
          "name" : "estabelecimentoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
