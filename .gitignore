*.log
logs/
*.tmp
*.bak
*.swp
*~


# =============================================================================
# IDE
# =============================================================================
.idea/
*.iml
*.ipr
*.iws
/out/

# Exclui o CONTEÚDO, não a pasta: o git não desce em diretório excluído,
# e sem isso a exceção abaixo nunca teria efeito.
.vscode/*
!.vscode/extensions.json
*.code-workspace

.settings/
.classpath
.project
