# Apenas NOMES de variáveis. Nunca versione valores reais.
# Copie para .env (que está no .gitignore) e preencha localmente.

POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB sobe sem autenticação no compose de desenvolvimento — auth em replica
# set exige --keyFile, que é segredo em arquivo. Ver o comentário no
# docker-compose.yml. Estas duas existem para o dia em que isso mudar.
# MONGO_USER=
# MONGO_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

GRAFANA_ADMIN_PASSWORD=

# identity-service — par de chaves RS256 (ADR-015).
# Gere localmente; a privada nunca entra no Git.
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=

CORS_ALLOWED_ORIGINS=
