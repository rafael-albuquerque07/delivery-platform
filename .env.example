# Apenas NOMES de variáveis. Nunca versione valores reais.
# Copie para .env (que está no .gitignore) e preencha localmente.

POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB sobe sem autenticação no compose de desenvolvimento — auth em replica
# set exige --keyFile, que é segredo em arquivo. Ver o comentário no
# docker-compose.yml. Estas duas existem para o dia em que isso mudar.
# MONGO_USER=
# MONGO_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# identity-service — par de chaves RS256 (ADR-015).
# Gere localmente; a privada nunca entra no Git.
#   openssl genrsa -out secrets/jwt-private.pem 2048
#   openssl rsa -in secrets/jwt-private.pem -pubout -out secrets/jwt-public.pem
# Só para o bootRun no host. No compose o caminho é fixo (/run/segredos, montado de
# secrets/jwt-private.pem) e esta variável não é lida.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
JWT_AUDIENCE=

# Origens que o gateway aceita. A porta 5173 é a do Vite (frontend/).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Documentação viva (Swagger UI) do merchant e do catalog, sem token. ADR-050.
# Só no seu computador. O padrão da aplicação é false, e é assim que ela sobe
# em qualquer outro lugar.
DELIVERY_DOCS_ABERTAS=false
